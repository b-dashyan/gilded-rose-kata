{
  "name": "gilded-rose-kata",
  "version": "1.0.0",
  "description": "Gilded Rose kata in TypeScript",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:unit": "stryker run stryker.unit.config.json",
    "golden-master": "node test/golden-master-text-test.ts",
    "typecheck": "tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "ci": "biome ci && tsc && vitest run --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
